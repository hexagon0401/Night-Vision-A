{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightvision.hexagon0401.workers.dev/schemas/event-context-v1.schema.json",
  "title": "NV2 UCDP Event Context Bundle v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_ref", "generated_at_utc", "query_plan", "provider_runs", "items", "counts"],
  "properties": {
    "schema_version": { "const": "event_context.v1" },
    "event_ref": {
      "type": "object",
      "required": ["id", "provider", "provider_version", "original_hash", "country", "title", "actors", "interval", "location"],
      "properties": {
        "id": {"type": "string", "pattern": "^ucdp:[a-zA-Z0-9_.:-]{1,175}$"},
        "provider": {"const": "ucdp"},
        "upstream_id": {"type": ["string", "null"]},
        "provider_version": {"type": "string"},
        "original_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "country": {"type": "string"},
        "title": {"type": "string"},
        "actors": {"type": "array", "items": {"type": "string"}, "maxItems": 12},
        "conflict_type": {"type": ["string", "null"]},
        "interval": {
          "type": "object",
          "required": ["from", "to", "precision_code"],
          "properties": {"from": {"type":"string","format":"date"}, "to": {"type":"string","format":"date"}, "precision_code":{"type":["integer","null"]}}
        },
        "location": {
          "type": "object",
          "required": ["lat", "lon", "where_prec", "geometry_geojson", "geometry_source", "certainty"],
          "properties": {
            "lat":{"type":["number","null"],"minimum":-90,"maximum":90},
            "lon":{"type":["number","null"],"minimum":-180,"maximum":180},
            "where_prec":{"type":["integer","null"],"minimum":1,"maximum":7},
            "geometry_geojson":{"type":["object","null"]},
            "geometry_source":{"type":["string","null"]},
            "certainty":{"enum":["point_reported","regional_only","unknown"]}
          }
        }
      }
    },
    "generated_at_utc": {"type":"string","format":"date-time"},
    "query_plan": {
      "type":"object",
      "required":["aliases","languages","radius_policy","chronology_window","eligible_sources","skipped_sources"],
      "properties": {
        "aliases":{"type":"array","items":{"type":"string"},"maxItems":24},
        "languages":{"type":"array","items":{"type":"string"},"maxItems":8},
        "radius_policy":{"type":"string"},
        "chronology_window":{"type":"object","required":["from","to"],"properties":{"from":{"type":"string","format":"date"},"to":{"type":"string","format":"date"}}},
        "eligible_sources":{"type":"array","items":{"type":"string"}},
        "skipped_sources":{"type":"object","additionalProperties":{"type":"string"}}
      }
    },
    "provider_runs": {"type":"array","maxItems":40,"items":{
      "type":"object",
      "required":["provider_id","status","started_at_utc","completed_at_utc","cached","retry_after_utc","diagnostics_code","fetched_count"],
      "properties":{
        "provider_id":{"type":"string"},
        "status":{"enum":["ok","empty","irrelevant","key_required","terms_pending","rate_limited","historical_unavailable","temporarily_failed","disabled"]},
        "started_at_utc":{"type":"string","format":"date-time"},
        "completed_at_utc":{"type":"string","format":"date-time"},
        "cached":{"type":"boolean"},
        "retry_after_utc":{"type":["string","null"]},
        "diagnostics_code":{"type":["string","null"]},
        "fetched_count":{"type":"integer","minimum":0}
      }
    }},
    "items": {"type":"array","maxItems":200,"items":{
      "type":"object",
      "required":["id","kind","provider_id","source_id","title","url","acquired_at_utc","temporal_role","evidence_role","relation_reasons","warnings","media_license_status","relevance"],
      "properties":{
        "id":{"type":"string"},
        "kind":{"enum":["article","photo","street_view","cctv","satellite","ais","adsb","official_notice","fire","other"]},
        "provider_id":{"type":"string"},
        "source_id":{"type":"string"},
        "title":{"type":"string"},
        "url":{"type":"string","format":"uri","pattern":"^https://"},
        "thumbnail_url":{"type":["string","null"]},
        "description":{"type":["string","null"]},
        "publisher":{"type":["string","null"]},
        "author":{"type":["string","null"]},
        "acquired_at_utc":{"type":"string","format":"date-time"},
        "published_at_utc":{"type":["string","null"]},
        "observed_from_utc":{"type":["string","null"]},
        "observed_to_utc":{"type":["string","null"]},
        "location":{"type":["object","null"]},
        "satellite":{"type":["object","null"]},
        "camera":{"type":["object","null"]},
        "temporal_role":{"enum":["event_time","post_event","present_context","unknown"]},
        "evidence_role":{"enum":["direct","corroborating","candidate","context_only","contradictory"]},
        "relation_reasons":{"type":"array","items":{"type":"string"}},
        "disconfirming_checks":{"type":"array","items":{"type":"string"}},
        "relevance":{"type":"object","required":["tier","feature_scores"],"properties":{"tier":{"enum":["high","medium","low","unscored"]},"feature_scores":{"type":"object","additionalProperties":{"type":["number","null"]}}}},
        "media_license_status":{"enum":["approved","link_only","terms_pending","denied"]},
        "attribution":{"type":["string","null"]},
        "source_independence_group":{"type":["string","null"]},
        "warnings":{"type":"array","items":{"type":"string"}},
        "raw_source_ref":{"type":["string","null"]}
      }
    }},
    "counts": {
      "type":"object",
      "required":["direct","corroborating","candidate","context_only","contradictory","total","inaccessible"],
      "properties":{
        "direct":{"type":"integer","minimum":0},
        "corroborating":{"type":"integer","minimum":0},
        "candidate":{"type":"integer","minimum":0},
        "context_only":{"type":"integer","minimum":0},
        "contradictory":{"type":"integer","minimum":0},
        "total":{"type":"integer","minimum":0},
        "inaccessible":{"type":"integer","minimum":0}
      }
    }
  }
}
