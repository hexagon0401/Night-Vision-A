{
  "$defs": {
    "Anomaly": {
      "additionalProperties": false,
      "properties": {
        "anomaly_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Anomaly Id",
          "type": "string"
        },
        "baseline_description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Baseline Description",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Grade",
          "default": "unknown"
        },
        "detector": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detector",
          "type": "string"
        },
        "detector_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detector Version",
          "type": "string"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "impact": {
          "$ref": "#/$defs/Grade",
          "default": "unknown"
        },
        "observation_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "severity": {
          "$ref": "#/$defs/Grade"
        },
        "window_end_utc": {
          "format": "date-time",
          "title": "Window End Utc",
          "type": "string"
        },
        "window_start_utc": {
          "format": "date-time",
          "title": "Window Start Utc",
          "type": "string"
        }
      },
      "required": [
        "evidence_status",
        "provenance",
        "anomaly_id",
        "observation_ids",
        "detector",
        "detector_version",
        "baseline_description",
        "window_start_utc",
        "window_end_utc",
        "severity"
      ],
      "title": "Anomaly",
      "type": "object"
    },
    "DetectionConfig": {
      "additionalProperties": false,
      "properties": {
        "cooldown_points": {
          "default": 8,
          "maximum": 128,
          "minimum": 1,
          "title": "Cooldown Points",
          "type": "integer"
        },
        "cusum_drift": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Cusum Drift",
          "type": "number"
        },
        "cusum_threshold": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Cusum Threshold",
          "type": "number"
        },
        "graph_edge_budget": {
          "default": 512,
          "maximum": 2048,
          "minimum": 16,
          "title": "Graph Edge Budget",
          "type": "integer"
        },
        "history_window": {
          "default": 64,
          "maximum": 256,
          "minimum": 4,
          "title": "History Window",
          "type": "integer"
        },
        "mad_threshold": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Mad Threshold",
          "type": "number"
        },
        "min_history": {
          "default": 8,
          "maximum": 128,
          "minimum": 4,
          "title": "Min History",
          "type": "integer"
        },
        "scale_floor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Scale Floor",
          "type": "number"
        },
        "seasonality": {
          "default": "none",
          "enum": [
            "none",
            "hour_of_day_utc"
          ],
          "title": "Seasonality",
          "type": "string"
        },
        "spatial_min_entities": {
          "default": 3,
          "maximum": 20,
          "minimum": 3,
          "title": "Spatial Min Entities",
          "type": "integer"
        },
        "spatial_point_budget": {
          "default": 256,
          "maximum": 512,
          "minimum": 3,
          "title": "Spatial Point Budget",
          "type": "integer"
        },
        "spatial_radius_km": {
          "default": 25.0,
          "exclusiveMinimum": 0,
          "maximum": 500,
          "title": "Spatial Radius Km",
          "type": "number"
        },
        "spatial_window_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Spatial Window Seconds",
          "type": "integer"
        }
      },
      "title": "DetectionConfig",
      "type": "object"
    },
    "EvidenceGraph": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "limited": {
          "title": "Limited",
          "type": "boolean"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "limited"
      ],
      "title": "EvidenceGraph",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "observed",
        "documented",
        "reported",
        "inferred",
        "scenario",
        "disputed",
        "unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Grade": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "Grade",
      "type": "string"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reported_by",
            "records_for",
            "supports",
            "claim_refers_to",
            "declared_relation",
            "candidate_cooccurrence",
            "counterevidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source",
        "target",
        "kind",
        "evidence_status",
        "source_ids",
        "explanation"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "source",
            "entity",
            "event",
            "observation",
            "claim",
            "anomaly"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "record_id",
        "kind",
        "label"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "corroborating_source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Corroborating Source Ids",
          "type": "array"
        },
        "evidence_span_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Span Hash"
        },
        "extraction_method": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Extraction Method",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "source_ids",
        "extraction_method"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Analysis Version",
      "type": "string"
    },
    "anomalies": {
      "items": {
        "$ref": "#/$defs/Anomaly"
      },
      "title": "Anomalies",
      "type": "array"
    },
    "calibration": {
      "const": "uncalibrated",
      "default": "uncalibrated",
      "title": "Calibration",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/DetectionConfig"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "data_origin": {
      "enum": [
        "synthetic",
        "source_backed"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "graph": {
      "$ref": "#/$defs/EvidenceGraph"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "data_origin",
    "configuration",
    "anomalies",
    "graph",
    "counts",
    "warnings"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
