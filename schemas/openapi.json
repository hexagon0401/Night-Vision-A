    "schemas": {
      "Anomaly": {
        "additionalProperties": false,
        "properties": {
          "anomaly_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Anomaly Id",
            "type": "string"
          },
          "baseline_description": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Baseline Description",
            "type": "string"
          },
          "confidence": {
            "$ref": "#/components/schemas/Grade",
            "default": "unknown"
          },
          "detector": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Detector",
            "type": "string"
          },
          "detector_version": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Detector Version",
            "type": "string"
          },
          "evidence_status": {
            "$ref": "#/components/schemas/EvidenceStatus"
          },
          "impact": {
            "$ref": "#/components/schemas/Grade",
            "default": "unknown"
          },
          "observation_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Observation Ids",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "severity": {
            "$ref": "#/components/schemas/Grade"
          },
          "window_end_utc": {
            "format": "date-time",
            "title": "Window End Utc",
            "type": "string"
          },
          "window_start_utc": {
            "format": "date-time",
            "title": "Window Start Utc",
            "type": "string"
          }
        },
        "required": [
          "evidence_status",
          "provenance",
          "anomaly_id",
          "observation_ids",
          "detector",
          "detector_version",
          "baseline_description",
          "window_start_utc",
          "window_end_utc",
          "severity"
        ],
        "title": "Anomaly",
        "type": "object"
      },
      "CaseBundle": {
        "additionalProperties": false,
        "properties": {
          "anomalies": {
            "items": {
              "$ref": "#/components/schemas/Anomaly"
