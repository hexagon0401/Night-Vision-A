            "title": "Anomalies",
            "type": "array"
          },
          "case_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Case Id",
            "type": "string"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "data_origin": {
            "enum": [
              "synthetic",
              "source_backed"
            ],
            "title": "Data Origin",
            "type": "string"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "title": "Entities",
            "type": "array"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Events",
            "type": "array"
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "title": "Hypotheses",
            "type": "array"
          },
          "narratives": {
            "items": {
              "$ref": "#/components/schemas/Narrative"
            },
            "title": "Narratives",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "title": "Observations",
            "type": "array"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/Relation"
            },
            "title": "Relations",
            "type": "array"
          },
          "schema_version": {
            "const": "2.0.0",
            "default": "2.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "title",
          "data_origin",
          "sources"
        ],
        "title": "CaseBundle",
        "type": "object"
      },
