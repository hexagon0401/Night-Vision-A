        "step_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "subtitle_en": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subtitle En",
          "type": "string"
        },
        "subtitle_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subtitle Ko",
          "type": "string"
        },
        "visible_entity_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
