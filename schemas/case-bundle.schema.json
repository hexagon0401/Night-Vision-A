    "EvidenceStatus": {
      "enum": [
        "observed",
        "documented",
        "reported",
        "inferred",
        "scenario",
        "disputed",
        "unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Grade": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "Grade",
      "type": "string"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "alternative_to": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Alternative To",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Grade",
          "default": "unknown"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "disconfirming_claim_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Disconfirming Claim Ids",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "hypothesis_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
