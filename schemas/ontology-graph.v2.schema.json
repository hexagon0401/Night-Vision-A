          "type": "string"
        },
        "candidate_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "detector": {
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detector",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "metric": {
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Metric",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "review_state": {
          "enum": [
            "candidate",
            "reviewed",
            "rejected"
          ],
          "title": "Review State",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "source_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "observed",
            "documented",
            "reported",
            "inferred",
            "scenario",
            "refuted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "entity_id",
        "metric",
        "detector",
        "baseline",
        "score",
        "calibration",
        "source_ids",
        "observation_ids",
        "status",
        "review_state"
      ],
      "title": "OntologyAnomaly",
      "type": "object"
    },
