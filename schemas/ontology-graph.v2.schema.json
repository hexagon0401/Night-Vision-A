    "OntologySource": {
      "additionalProperties": false,
      "properties": {
        "access_status": {
          "enum": [
            "opened",
            "metadata_only",
            "failed",
            "restricted",
            "not_fetched"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "acquired_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acquired At Utc"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "derived_from_source_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Derived From Source Id"
        },
        "independence_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Independence Group"
        },
        "indexed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Indexed At Utc"
        },
        "license_status": {
          "enum": [
            "approved",
            "metadata_only",
            "pending",
            "prohibited",
            "unknown"
          ],
          "title": "License Status",
          "type": "string"
        },
        "original_or_derived": {
          "enum": [
            "original",
            "derived",
            "unknown"
          ],
          "title": "Original Or Derived",
          "type": "string"
        },
        "published_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At Utc"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "quote_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Span"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "url",
        "publisher",
        "content_hash",
        "original_or_derived",
        "derived_from_source_id",
        "independence_group",
        "published_at_utc",
        "indexed_at_utc",
        "acquired_at_utc",
        "license_status",
        "access_status"
      ],
      "title": "OntologySource",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    }
  },
