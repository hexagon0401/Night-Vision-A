{
  "$defs": {
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_link_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Evidence Link Id",
          "type": "string"
        },
        "quote_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Span"
        },
        "role": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "MENTIONS",
            "DERIVED_FROM",
            "UNVERIFIED_MATCH"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "documented",
            "reported",
            "inferred",
            "scenario",
            "refuted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_link_id",
        "claim_id",
        "source_id",
        "role",
        "quote_span",
        "status"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "completed_at_utc": {
          "format": "date-time",
          "title": "Completed At Utc",
          "type": "string"
        },
        "tool_call_id": {
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Call Id",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "tool_call_id",
        "completed_at_utc"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "JsonValue": {},
    "ModuleRun": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "completed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At Utc"
        },
        "executor": {
          "enum": [
            "deterministic_adapter",
            "inline_skill",
            "mcp_remote_verified",
            "not_executed"
          ],
          "title": "Executor",
          "type": "string"
        },
        "input_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Hash"
        },
        "module": {
          "maxLength": 5000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Module",
          "type": "string"
        },
        "module_run_id": {
          "maxLength": 256,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9:._@-]+$",
          "title": "Module Run Id",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Hash"
        },
        "started_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At Utc"
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "not_executed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "module_run_id",
        "case_id",
        "module",
        "status",
        "executor",
        "started_at_utc",
        "completed_at_utc",
        "input_hash",
        "result_hash",
        "receipt"
      ],
      "title": "ModuleRun",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "OntologyAnomaly": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
