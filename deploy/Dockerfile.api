# syntax=docker/dockerfile:1
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /app
COPY requirements-runtime.txt ./
COPY engine ./engine
COPY services/api ./services/api
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; \
    python -m pip install --no-cache-dir -c requirements-runtime.txt './engine[collect,storage]' ./services/api
RUN useradd --uid 10001 --create-home nv
COPY --chown=10001:10001 services/worker ./services/worker
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"
CMD ["python","-m","uvicorn","nv_api.app:app","--host","0.0.0.0","--port","8000","--workers","1"]
